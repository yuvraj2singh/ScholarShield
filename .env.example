# ── Next.js ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Python Analysis Engine ────────────────────────────────
# Set to your deployed FastAPI URL in production
ANALYSIS_ENGINE_URL=http://localhost:8000

# ── Database (Prisma + MongoDB) ───────────────────────────
# MongoDB Atlas (Cloud):
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/scholarshield?retryWrites=true&w=majority"
# Or Local MongoDB:
# DATABASE_URL="mongodb://127.0.0.1:27017/scholarshield"

# ── Auth (NextAuth + Google OAuth) ─────────────────────────
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# ── Email (Optional: Resend) ──────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── FTC Reporting Webhook ─────────────────────────────────
# FTC_WEBHOOK_URL=https://your-ftc-endpoint.gov/webhook
